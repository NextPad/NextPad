#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# First start: create /config folders, set ownership, generate an API key if missing.

mkdir -p /config/data /config/secrets /config/theme

if [[ ! -s /config/secrets/api-keys.txt ]]; then
    key="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48)"
    printf '# One key per line, optionally followed by the Moodle URL: <key> https://moodle.example.org\n%s\n' "${key}" > /config/secrets/api-keys.txt
    echo "**** New API key in /config/secrets/api-keys.txt (enter it in mod_etherpadlite in Moodle) ****"
fi

lsiown -R abc:abc /config/data
lsiown abc:abc /config /config/secrets /config/theme
chmod 750 /config/secrets
find /config/secrets -type f -exec chown abc:abc {} + -exec chmod 640 {} +
