# Vorlage für .env neben docker-compose.yml. Nur Platzhalter, keine echten Werte ins Repo.
PUID=1000
PGID=1000
TZ=Europe/Berlin
# Öffentliche Adresse hinter dem Reverse-Proxy (für LTI, QR-Codes und Mails)
NEXTPAD_PUBLIC_URL=https://pads.example.org
# nextpad (eckig), rund, colibris (wie Etherpad) oder hsd (braucht ./config/theme)
NEXTPAD_THEME=nextpad
# Pads von der Startseite ohne Moodle
NEXTPAD_ALLOW_FREE_PADS=true
# Hinter einem Reverse-Proxy: true und dessen Adresse
NEXTPAD_TRUST_PROXY=true
NEXTPAD_TRUSTED_PROXIES=192.0.2.1
# Adresse der Moodle-Instanz, die die Etherpad-API aufrufen darf
NEXTPAD_API_ALLOWED=192.0.2.10
# Ordner für Daten, Schlüssel und Theme; Port auf 127.0.0.1
NEXTPAD_CONFIG=./config
NEXTPAD_PORT=5090
