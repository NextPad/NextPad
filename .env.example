# Copy to .env. Do not commit real values.
PUID=1000
PGID=1000
TZ=Europe/Berlin
# public URL behind the reverse proxy (LTI, QR codes, mail links)
NEXTPAD_PUBLIC_URL=https://pads.example.org
# nextpad, rund, colibris or hsd (needs ./config/theme)
NEXTPAD_THEME=nextpad
# pads from the start page, without signing in through a course
NEXTPAD_ALLOW_FREE_PADS=true
# behind a reverse proxy: true, plus its address
NEXTPAD_TRUST_PROXY=true
NEXTPAD_TRUSTED_PROXIES=192.0.2.1
# Moodle server allowed to call the Etherpad API (mod_etherpadlite)
NEXTPAD_API_ALLOWED=192.0.2.10
NEXTPAD_CONFIG=./config
NEXTPAD_PORT=5090
